DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-secure-password
DB_DATABASE=postgres
# Administrative maintenance database used by local operations scripts.
DB_MAINTENANCE_DATABASE=postgres
SECRET=replace-with-a-cryptographically-secure-random-value
HOST=0.0.0.0
PORT=3000
# Optional tenant hostname suffix; defaults to bionexus.app.
BIONEXUS_TENANT_DOMAIN=bionexus.app
CORS_ORIGINS=http://localhost:8080
HTTPS_ENABLED=false
TLS_KEY_PATH=local.key
TLS_CERT_PATH=local.crt
